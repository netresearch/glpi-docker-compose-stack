root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{sh,bash}]
indent_size = 2

[Dockerfile*]
indent_size = 2

[Makefile]
indent_style = tab

[*.{php,phpt}]
indent_size = 4
